# ==============================================================================
# CONFIGURAÇÕES DO SUPABASE - MERLY BEAUTY STUDIO
# ==============================================================================
# Instruções para encontrar suas chaves no Supabase:
# 1. Acesse o painel: https://supabase.com/dashboard
# 2. Selecione seu projeto.
# 3. No menu lateral esquerdo, clique no ícone de engrenagem "Project Settings" (Configurações do Projeto).
# 4. No submenu que abrir, clique em "API" (ou "Data API").
# 5. Em "Project URL", copie o endereço (ex: https://xyzcompany.supabase.co)
# 6. Em "Project API Keys", copie a chave "anon" "public" (NUNCA use a service_role no frontend!).
# ==============================================================================

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
